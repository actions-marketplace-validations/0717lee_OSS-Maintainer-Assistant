# ---------------------------------------------------------------------------
# maintainer-agent configuration. Copy to `.env` and fill in what you need.
# EVERYTHING here is optional: with no keys set, the project runs fully offline
# using bundled fixtures and a deterministic rule-based MockLLM.
# ---------------------------------------------------------------------------

# --- LLM (optional) ---------------------------------------------------------
# When a model + matching provider key are set, agents use a real LLM via litellm.
# Otherwise they fall back to the deterministic MockLLM (great for demos/CI).
#
# DeepSeek (high cost-performance, accessible from China)
# Get your key at: https://platform.deepseek.com
MAINTAINER_AGENT_LLM_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=
#
# OpenAI (great default)
# MAINTAINER_AGENT_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
#
# Anthropic Claude
# MAINTAINER_AGENT_LLM_MODEL=claude-3-5-haiku
# ANTHROPIC_API_KEY=

# --- Per-agent models (optional) --------------------------------------------
# Override the global model for specific agents. Same API key works for all.
# Triage & Digest: fast model for classification and summaries.
# Quality & Responder: strong model, but only called for suspicious items (tiered).
#   - score < 0.3: skip LLM entirely (heuristic is enough)
#   - score 0.3-0.6: pro model for slop scoring
#   - high-risk replies: pro model for nuanced rewriting
# MAINTAINER_AGENT_LLM_MODEL_TRIAGE=deepseek/deepseek-v4-flash
# MAINTAINER_AGENT_LLM_MODEL_DIGEST=deepseek/deepseek-v4-flash
# MAINTAINER_AGENT_LLM_MODEL_QUALITY=deepseek/deepseek-v4-pro
# MAINTAINER_AGENT_LLM_MODEL_RESPONDER=deepseek/deepseek-v4-pro

# --- Embedding (optional) ---------------------------------------------------
# When set + a provider key is available, duplicate detection uses real LLM
# embeddings via litellm. Otherwise falls back to deterministic feature-hashing.
# Recommended: openai/text-embedding-3-small (cheapest, 1536 dims)
# MAINTAINER_AGENT_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Vectors (optional) ----------------------------------------------------
# Vector store backend for duplicate detection: tfidf (default), faiss, or chroma.
# faiss and chroma require the [vectors] or [chroma] extras respectively.
MAINTAINER_AGENT_VECTORS=tfidf

# --- GitHub (optional) ------------------------------------------------------
# A read-only token lets the client fetch live issues/PRs. Without it, the
# bundled offline fixtures (github/fixtures/) are used instead.
GITHUB_TOKEN=

# --- Webhook (optional) ----------------------------------------------------
# Set a secret to verify incoming GitHub webhook signatures (HMAC SHA-256).
# Leave empty to skip verification (useful for local dev, not recommended for prod).
MAINTAINER_AGENT_WEBHOOK_SECRET=

# --- Safety / runtime -------------------------------------------------------
# Default is dry-run: the agent NEVER posts to GitHub unless you pass --apply
# on the CLI AND approve each action. This flag only affects logging verbosity.
MAINTAINER_AGENT_LOG_LEVEL=INFO
